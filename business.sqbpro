<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="business.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2240"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="expenses" custom_title="0" dock_id="1" table="4,8:mainexpenses"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011800ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">
WITH supplier_prices AS (
    SELECT
        i.id AS inventory_id,
        i.item AS product,
        s.supplier_id,
        s.name AS supplier,
        AVG(pi.unit_cost) AS average_unit_cost,
        COUNT(*) AS purchase_records,
        SUM(pi.quantity_purchased) AS total_units_purchased,
        ROW_NUMBER() OVER (
            PARTITION BY i.id
            ORDER BY AVG(pi.unit_cost) ASC, s.supplier_id ASC
        ) AS supplier_rank
    FROM purchase_items AS pi
    JOIN purchase_receipts AS pr
        ON pi.receipt_id = pr.receipt_id
    JOIN suppliers AS s
        ON pr.supplier_id = s.supplier_id
    JOIN inventory AS i
        ON pi.inventory_id = i.id
    WHERE pi.unit_cost IS NOT NULL
      AND pi.unit_cost &gt; 0
    GROUP BY
        i.id,
        i.item,
        s.supplier_id,
        s.name
)
SELECT
    product,
    supplier,
    ROUND(average_unit_cost, 2) AS average_unit_cost,
    purchase_records,
    total_units_purchased
FROM supplier_prices
WHERE supplier_rank = 1
ORDER BY product;
</sql><current_tab id="0"/></tab_sql></sqlb_project>
